<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="arm_ros2_control" params="name use_fake_hardware:=false can_interface:=slcan0 use_gripper:=false">
    
    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_fake_hardware}">
          <!-- Use fake hardware for testing/simulation -->
          <plugin>cubemars_hardware/FakeCubeMarsHardware</plugin>
        </xacro:if>
        <xacro:unless value="${use_fake_hardware}">
          <!-- Use real CubeMars hardware -->
          <plugin>cubemars_hardware/CubeMarsSystemHardware</plugin>
          <param name="can_interface">${can_interface}</param>
        </xacro:unless>
      </hardware>

      <!-- Joint 1 -->
      <joint name="Joint_1">
        <param name="can_id">30</param>
        <param name="pole_pairs">21</param>
        <param name="gear_ratio">9</param>
        <param name="kt">0.1</param>
        <param name="vel_limit">7.5</param>
        <param name="acc_limit">10.0</param>
        <param name="enc_off">0.0</param>
        <param name="read_only">0</param>
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- Joint 2 -->
      <joint name="Joint_2">
        <param name="can_id">31</param>
        <param name="pole_pairs">21</param>             
        <param name="gear_ratio">64</param>
        <param name="kt">0.105</param>
        <param name="vel_limit">12.0</param>
        <param name="acc_limit">10.0</param>
        <param name="enc_off">0.0</param>
        <param name="direction">-1</param>
        <param name="read_only">0</param>
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- Joint 3 -->
      <joint name="Joint_3">
        <param name="can_id">32</param>
        <param name="pole_pairs">21</param>
        <param name="gear_ratio">64</param>
        <param name="kt">0.105</param>
        <param name="vel_limit">5.03</param>
        <param name="acc_limit">3.0</param>
        <param name="enc_off">0.0</param>
        <param name="read_only">0</param>
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- Joint 4 -->
      <joint name="Joint_4">
        <param name="can_id">33</param>
        <param name="pole_pairs">21</param>
        <param name="gear_ratio">9</param>
        <param name="kt">0.1</param>
        <param name="vel_limit">2.5</param>
        <param name="acc_limit">5.0</param>
        <param name="enc_off">0.0</param>
        <param name="read_only">0</param>
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- Joint 5 -->
      <joint name="Joint_5">
        <param name="can_id">34</param>
        <param name="pole_pairs">21</param>
        <param name="gear_ratio">9</param>
        <param name="kt">0.1</param>
        <param name="vel_limit">17.5</param>
        <param name="acc_limit">10.0</param>
        <param name="enc_off">0.0</param>
        <param name="read_only">0</param>
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

    </ros2_control>

    <xacro:if value="${use_gripper}">
      <ros2_control name="DynamixelSystem" type="system">
        <hardware>
          <xacro:if value="${use_fake_hardware}">
            <plugin>mock_components/GenericSystem</plugin>
          </xacro:if>
          <xacro:unless value="${use_fake_hardware}">
            <plugin>dynamixel_interface/DynamixelSystem</plugin>
            <param name="device_name">/dev/ttyUSB0</param>
            <param name="baud_rate">57600</param>
          </xacro:unless>
        </hardware>

        <!-- Gripper Left Finger -->
        <joint name="Finger_Left_Joint">
          <param name="id">1</param>
          <!-- Map MoveIt/URDF gripper travel to calibrated Dynamixel motor radians.
               URDF: 0.0 = closed, 0.08 = open. Dynamixel: -1.9 = closed, 2.9 = open. -->
          <param name="position_to_motor_scale">60.0</param>
          <param name="position_to_motor_offset">-1.9</param>
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </ros2_control>
    </xacro:if>

  </xacro:macro>

</robot>
