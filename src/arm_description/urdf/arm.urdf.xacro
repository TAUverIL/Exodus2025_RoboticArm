<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="exodus_arm">

  <xacro:arg name="use_fake_hardware" default="false"/>
  <xacro:arg name="can_interface" default="slcan0"/>
  <xacro:arg name="use_gripper" default="false"/>

  <xacro:include filename="$(find arm_description)/urdf/AssemblyURDF_27.04.26.urdf"/>
  <xacro:include filename="$(find arm_description)/urdf/arm.ros2_control.xacro"/>

  <xacro:arm_ros2_control
    name="ExodusArmSystem"
    use_fake_hardware="$(arg use_fake_hardware)"
    can_interface="$(arg can_interface)"
    use_gripper="$(arg use_gripper)"/>

  <!-- Camera Attached to Link_3 -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.04 0.1 0.04"/>
      </geometry>
      <material name="camera_material">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.1 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="Link_3"/>
    <child link="camera_link"/>
    <!-- Position the camera in the middle of Link_3 (which is ~0.45m long along -X) and slightly above it -->
    <origin xyz="-0.226 0.0 0.08" rpy="0 0 0"/> 
  </joint>

</robot>
